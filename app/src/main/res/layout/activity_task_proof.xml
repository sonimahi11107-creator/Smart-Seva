<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#1A1A2E">

        <ImageButton
            android:id="@+id/btnBackProof"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="#2D2D44"
            android:tint="#FFFFFF"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Task Proof"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit &amp; Verify completion proof"
                android:textColor="#9E9EB8"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Task Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTaskTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Task Title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvSubmitStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upload photo + GPS to submit"
                        android:textSize="12sp"
                        android:textColor="#6B7280"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTaskStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="#6B7280"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Photo Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Photo Proof"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="10dp"/>

            <ImageView
                android:id="@+id/imgProofPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/photo_placeholder_bg"
                android:src="@drawable/ic_add_photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📷 Upload Proof Photo"
                android:backgroundTint="#1A1A2E"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- GPS Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 GPS Location Proof"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvGPSStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 GPS not captured yet"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnGetGPS"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📡 Capture GPS Location"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Submit Button (Volunteer) -->
            <Button
                android:id="@+id/btnSubmitProof"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✅ Submit Completion Proof"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:enabled="false"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/progressSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- Verify Button (NGO) -->
            <Button
                android:id="@+id/btnVerifyProof"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔍 Verify Submitted Proofs"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- Proof History -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Proof History"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutProofHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>