<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBackMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ Community Needs Map"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMapSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading needs..."
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button android:id="@+id/btnMapAll"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="All" android:textSize="11sp"
                android:backgroundTint="#1A1A1A" android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <Button android:id="@+id/btnMapCritical"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="🔴 Critical" android:textSize="11sp"
                android:backgroundTint="#E0E0E0" android:textColor="#1A1A1A"
                android:layout_marginEnd="6dp"/>

            <Button android:id="@+id/btnMapFood"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="🍽️ Food" android:textSize="11sp"
                android:backgroundTint="#E0E0E0" android:textColor="#1A1A1A"
                android:layout_marginEnd="6dp"/>

            <Button android:id="@+id/btnMapMedical"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="🏥 Medical" android:textSize="11sp"
                android:backgroundTint="#E0E0E0" android:textColor="#1A1A1A"
                android:layout_marginEnd="6dp"/>

            <Button android:id="@+id/btnMapEducation"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="📚 Education" android:textSize="11sp"
                android:backgroundTint="#E0E0E0" android:textColor="#1A1A1A"
                android:layout_marginEnd="6dp"/>

            <Button android:id="@+id/btnMapOpen"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:text="🔵 Open Only" android:textSize="11sp"
                android:backgroundTint="#E0E0E0" android:textColor="#1A1A1A"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvMapTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="18sp" android:textStyle="bold"
                android:textColor="#1A1A1A"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Total" android:textSize="10sp" android:textColor="#888"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvMapCriticalCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="18sp" android:textStyle="bold"
                android:textColor="#C62828"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Critical" android:textSize="10sp" android:textColor="#888"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvMapOpenCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="18sp" android:textStyle="bold"
                android:textColor="#1565C0"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Open" android:textSize="10sp" android:textColor="#888"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvMapResolvedCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="18sp" android:textStyle="bold"
                android:textColor="#2E7D32"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Resolved" android:textSize="10sp" android:textColor="#888"/>
        </LinearLayout>
    </LinearLayout>

    <!-- WebView Map -->
    <android.webkit.WebView
        android:id="@+id/webViewCommunityMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom Sheet — Selected Need Info -->
    <LinearLayout
        android:id="@+id/layoutSelectedNeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tvSelectedLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Location"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedUrgency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Critical"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#C62828"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectedApply"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Apply Now"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSelectedClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="✕"
                android:backgroundTint="#E0E0E0"
                android:textColor="#1A1A1A"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>