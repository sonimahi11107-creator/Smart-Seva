<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1A1A1A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBackProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Volunteer Profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvProfileStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#F57F17"
            android:padding="6dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A1A"
                android:gravity="center"
                android:padding="24dp">

                <!-- Profile Photo -->
                <ImageView
                    android:id="@+id/imgVolunteerPhoto"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/photo_placeholder_bg"
                    android:src="@drawable/ic_add_photo"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvVolName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volunteer Name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvVolCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 City, State"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvVolEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉ email@example.com"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvVolPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 +91 XXXXXXXXXX"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Quick Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvStatTasksDone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tasks Done" android:textSize="11sp" android:textColor="#888"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#EEEEEE"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvStatImpact"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Impact Pts" android:textSize="11sp" android:textColor="#888"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#EEEEEE"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvStatRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ 0.0" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Rating" android:textSize="11sp" android:textColor="#888"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Skills Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🛠️ Skills"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A1A" android:layout_marginBottom="12dp"/>

                <LinearLayout android:id="@+id/layoutSkillChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- Availability Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⏰ Availability"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A1A" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Available Days"
                            android:textSize="12sp" android:textColor="#888"/>
                        <TextView android:id="@+id/tvVolAvailDays"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp" android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Time Commitment"
                            android:textSize="12sp" android:textColor="#888"/>
                        <TextView android:id="@+id/tvVolAvailTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp" android:textColor="#1A1A1A"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Extra Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="📋 Details"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A1A" android:layout_marginBottom="12dp"/>

                <!-- Languages -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🗣️ Languages: "
                        android:textSize="13sp" android:textColor="#555" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvVolLanguages"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Vehicle -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🚗 Has Vehicle: "
                        android:textSize="13sp" android:textColor="#555" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvVolVehicle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Travel -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✈️ Can Travel: "
                        android:textSize="13sp" android:textColor="#555" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvVolTravel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Experience -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💼 Experience: "
                        android:textSize="13sp" android:textColor="#555" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvVolExperience"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- ID Type -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪪 ID Verified: "
                        android:textSize="13sp" android:textColor="#555" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvVolIDType"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✅ Aadhaar Card"
                        android:textSize="13sp" android:textColor="#2E7D32"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Causes Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="❤️ Causes They Care About"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A1A" android:layout_marginBottom="12dp"/>

                <LinearLayout android:id="@+id/layoutCauseChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- Contact Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="📞 Contact Volunteer"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A1A" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnCallVolunteer"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📞 Call"
                        android:textSize="13sp"
                        android:backgroundTint="#1565C0"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp"/>

                    <Button android:id="@+id/btnSMSVolunteer"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="💬 SMS"
                        android:textSize="13sp"
                        android:backgroundTint="#2E7D32"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom space -->
            <View android:layout_width="match_parent" android:layout_height="100dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="12dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnProfileAccept"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="✓ Accept"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnProfileReject"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="✗ Reject"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>