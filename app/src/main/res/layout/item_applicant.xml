<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Profile Photo -->
        <ImageView
            android:id="@+id/imgApplicantPhoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="@drawable/photo_placeholder_bg"
            android:src="@drawable/ic_add_photo"
            android:layout_marginEnd="12dp"/>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvApplicantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volunteer Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView
                android:id="@+id/tvApplicantCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 City, State"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvApplicantSkills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠️ Skills"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvApplicantTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 Applied: just now"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvApplicantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#F57F17"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnViewProfile"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="View Profile"
            android:textSize="12sp"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✓ Accept"
            android:textSize="12sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✗ Reject"
            android:textSize="12sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>