<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fill all details accurately for verification"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="20dp"/>

        <!-- Tab Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnTabNGO"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="NGO / Organisation"
                android:textSize="13sp"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnTabVolunteer"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Volunteer"
                android:textSize="13sp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#1A1A1A"/>
        </LinearLayout>

        <!-- NGO FORM -->
        <LinearLayout
            android:id="@+id/layoutNGO"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Organisation Name -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Organisation Name *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etOrgName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Green Earth Foundation"
                android:inputType="textPersonName"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errOrgName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Registration Number -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Registration / Trust No. *" android:textSize="12sp" android:textColor="#555"/>

            <TextView android:id="@+id/errRegNo" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- NGO Type -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Type of NGO *" android:textSize="12sp" android:textColor="#555"/>
            <Spinner
                android:id="@+id/spinnerNGOType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <!-- Official Email -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Official Email *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etNGOEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="contact@organisation.org"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etRegNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:hint="e.g. DIT/2020/1234"
                android:inputType="text" />

            <TextView android:id="@+id/errNGOEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Phone -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Phone Number *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etNGOPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="10-digit number"
                android:inputType="phone"
                android:maxLength="10"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errNGOPhone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Address -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Registered Address *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etNGOAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full registered address"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errNGOAddress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Password -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Password *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etNGOPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Min 8 chars, 1 number"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errNGOPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Confirm Password -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Confirm Password *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etNGOConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errNGOConfirmPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnRegisterNGO"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Register Organisation"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- VOLUNTEER FORM -->
        <LinearLayout
            android:id="@+id/layoutVolunteer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- First Name -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="First Name *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Priya"
                android:inputType="textPersonName"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errFirstName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Last Name -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Last Name *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Sharma"
                android:inputType="textPersonName"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errLastName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Email -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Email Address *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etVolEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="yourname@example.com"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errVolEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Phone -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Phone Number *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etVolPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="10-digit number"
                android:inputType="phone"
                android:maxLength="10"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errVolPhone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Passport Photo -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Passport Photo *" android:textSize="12sp" android:textColor="#555"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/imgPassportPhoto"
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/photo_placeholder_bg"
                    android:src="@drawable/ic_add_photo"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnUploadPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Choose Photo"
                        android:textSize="12sp"
                        android:backgroundTint="#1A1A1A"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG or PNG, max 2MB\nWhite background preferred"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/errPassportPhoto" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Government ID -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Government ID Type *" android:textSize="12sp" android:textColor="#555"/>
            <Spinner
                android:id="@+id/spinnerIDType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <!-- ID Number -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ID Number *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etIDNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your ID number"
                android:inputType="text"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errIDNumber" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Password -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Password *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etVolPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Min 8 chars, 1 number"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errVolPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="12dp"/>

            <!-- Confirm Password -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Confirm Password *" android:textSize="12sp" android:textColor="#555"/>
            <EditText
                android:id="@+id/etVolConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/errVolConfirmPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#E24B4A"
                android:textSize="11sp" android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnRegisterVolunteer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Register as Volunteer"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>