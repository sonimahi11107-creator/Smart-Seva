<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Status Bar Top -->
    <View
        android:id="@+id/viewStatusBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#1565C0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"/>

                <TextView
                    android:id="@+id/tvTaskStatusCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Urgency Badge -->
            <TextView
                android:id="@+id/tvTaskUrgencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Critical"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#C62828"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- Status Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Open -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusOpen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="1"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/step_active_bg"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open"
                    android:textSize="9sp"
                    android:textColor="#555"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View
                android:id="@+id/line1Status"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#CCCCCC"/>

            <!-- Assigned -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusAssigned"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="2"
                    android:gravity="center"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/step_inactive_bg"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned"
                    android:textSize="9sp"
                    android:textColor="#555"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View
                android:id="@+id/line2Status"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#CCCCCC"/>

            <!-- In Progress -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusInProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="3"
                    android:gravity="center"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/step_inactive_bg"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Progress"
                    android:textSize="9sp"
                    android:textColor="#555"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View
                android:id="@+id/line3Status"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#CCCCCC"/>

            <!-- Resolved -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusResolved"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✓"
                    android:gravity="center"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/step_inactive_bg"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resolved"
                    android:textSize="9sp"
                    android:textColor="#555"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Task Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTaskStatusLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Location"
                android:textSize="12sp"
                android:textColor="#555"/>

            <TextView
                android:id="@+id/tvTaskStatusDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Date"
                android:textSize="12sp"
                android:textColor="#555"/>
        </LinearLayout>

        <!-- Assigned Volunteer -->
        <LinearLayout
            android:id="@+id/layoutAssignedVol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Assigned to: "
                android:textSize="12sp"
                android:textColor="#555"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAssignedVolName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volunteer Name"
                android:textSize="12sp"
                android:textColor="#1565C0"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutStatusActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUpdateStatus"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Update Status"
                android:textSize="11sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnViewDetails"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="View Details"
                android:textSize="11sp"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>