<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="2dp"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Score Circle -->
        <LinearLayout
            android:id="@+id/layoutScoreCircle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A1A1A"
            android:layout_marginEnd="12dp">

            <TextView android:id="@+id/tvMatchScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="#AAAAAA"
                android:textSize="9sp"/>
        </LinearLayout>

        <!-- Info -->
        <LinearLayout android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvMatchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView android:id="@+id/tvMatchCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 City"
                android:textSize="12sp"
                android:textColor="#888888"/>

            <TextView android:id="@+id/tvMatchSkills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠️ Skills"
                android:textSize="12sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- Match Label -->
        <TextView android:id="@+id/tvMatchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Excellent"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#2E7D32"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Match Reason -->
    <TextView android:id="@+id/tvMatchReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Match reason"
        android:textSize="11sp"
        android:textColor="#555555"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Score Bar -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Match: "
            android:textSize="11sp"
            android:textColor="#888"/>

        <ProgressBar
            android:id="@+id/progressMatch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="85"
            android:progressTint="#2E7D32"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView android:id="@+id/tvMatchPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>
    </LinearLayout>

    <!-- Action Button -->
    <Button android:id="@+id/btnMatchAction"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="View Profile"
        android:textSize="13sp"
        android:backgroundTint="#1A1A1A"
        android:textColor="#FFFFFF"/>

</LinearLayout>